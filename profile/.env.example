# =========================================================================
# CONFIGURAÇÃO DE SEGURANÇA - LOPE PROFILE PAYMENTS
# =========================================================================
# ATENÇÃO: NUNCA insira as chaves reais neste arquivo (.env.example).
# Copie este arquivo e renomeie-o para `.env.local` para rodar localmente.
# Adicione estas mesmas chaves diretamente no painel da Vercel para produção.
# =========================================================================

# ❌ CHAVES PRIVADAS (NÃO use o prefixo NEXT_PUBLIC_):
# Estas variáveis rodam apenas do lado do servidor (Serverless API Routes).
# Estão 100% blindadas contra vazamentos no navegador do cliente.

# Token de acesso da API do Asaas
ASAAS_API_KEY=$aact_hmlg_000MzkwODA2MWY2OGM3MWRlMDU2NWM3MzJlNzZmNGZhZGY6OmU2OTZiMWZmLTEwZmItNDJhZS04ZTA1LTg0NmYwYTZjOWUwNTo6JGFhY2hfMjdlMzRjZjYtMGQyOC00MjY0LWI2YTktZDZlMzE3YTk5ODdj

# URL Base da API do Asaas:
# Sandbox (Desenvolvimento/Testes): https://sandbox.asaas.com/api/v3
# Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://sandbox.asaas.com/api/v3

# =========================================================================
# BANCO DE DADOS - PRISMA ORM (PostgreSQL - Vercel Postgres / Neon)
# =========================================================================
# URL de conexão com o banco de dados Postgres da Vercel
# A Vercel gera isso automaticamente ao vincular o banco Postgres ao projeto.
# Formato: postgres://USUARIO:SENHA@HOST/NOME_DO_BANCO?sslmode=require
DATABASE_URL="postgres://default:senha@host-neon.neon.tech/neondb?sslmode=require"
